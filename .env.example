# Copy this file to ".env" and fill in your own values.
# NEVER commit .env to GitHub. Use a fresh test wallet that holds only Sepolia test ETH.

# RPC endpoint for Sepolia (Alchemy / Infura / public node)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of your TEST wallet (with or without 0x prefix)
PRIVATE_KEY=

# Etherscan API key (https://etherscan.io/myapikey) for contract verification
ETHERSCAN_API_KEY=
